{
  "name": "deadcards",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./scripts/register-test.mjs --test tests/*.test.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply deadcards --local",
    "db:migrate:remote": "wrangler d1 migrations apply deadcards --remote",
    "typegen": "wrangler types",
    "db:import": "node scripts/import-save.mjs"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@cf-wasm/resvg": "^0.4.0",
    "better-auth": "^1.7.25",
    "gsap": "^3.15.1",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.20.0"
  }
}
